{
  "$schema": "./node_modules/syncpack/schema.json",
  "source": [
    "package.json",
    "packages/*/package.json",
    "apps/*/package.json",
    "!**/dist/**",
    "!**/templates/**"
  ],
  "versionGroups": [
    {
      "label": "Workspace packages must use the workspace: protocol",
      "dependencies": ["ovo-*", "ovo"],
      "dependencyTypes": ["dev", "prod", "peer"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "ovo host peer ranges are intentionally broad",
      "dependencies": ["next", "react"],
      "packages": ["ovo"],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "Next.js projects pin TypeScript 6 for its compiler API",
      "dependencies": ["typescript"],
      "packages": ["ovo-docs", "framework-next", "web-chat-next-template"],
      "dependencyTypes": ["dev"],
      "pinVersion": "6.0.3"
    },
    {
      "label": "Shared third-party deps must use the catalog: protocol",
      "policy": "catalog",
      "dependencies": [
        "@types/node",
        "typescript",
        "next",
        "@types/react",
        "@types/react-dom",
        "picocolors",
        "react",
        "react-dom",
        "streamdown",
        "vitest",
        "zod"
      ],
      "dependencyTypes": ["dev", "prod", "peer"]
    },
    {
      "label": "Other dependencies are not enforced",
      "dependencies": ["**"],
      "isIgnored": true
    }
  ]
}
