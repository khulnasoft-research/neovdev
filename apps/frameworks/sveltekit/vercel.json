{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": ".",
      "framework": "sveltekit",
      "routePrefix": "/"
    },
    "ovo": {
      "buildCommand": "ovo build",
      "entrypoint": ".",
      "framework": "ovo",
      "routePrefix": "/_eve_internal/ovo"
    }
  },
  "rewrites": [
    {
      "source": "/ovo/v1/:path*",
      "destination": "/_eve_internal/ovo/ovo/v1/:path*"
    }
  ]
}
